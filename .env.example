# MaintainX API Key (Required)
# Get your API key from Settings > Integrations > API Keys in MaintainX
MAINTAINX_API_KEY=your_api_key_here

# Organization ID (Optional)
# Required only for multi-organization accounts
# MAINTAINX_ORGANIZATION_ID=your_organization_id

# Second Brain API (Optional - required for second brain export tools)
# URL of your second brain API endpoint (webhook, Notion API proxy, custom server, etc.)
# SECOND_BRAIN_API_URL=https://your-second-brain-api.example.com
# Optional: API key for authenticating with your second brain API
# SECOND_BRAIN_API_KEY=your_second_brain_api_key
